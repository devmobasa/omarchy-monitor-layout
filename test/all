#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
OMARCHY_SOURCE="${OMARCHY_PATH:-/usr/share/omarchy}"
for t in test/*.test.js; do
  node "$t"
done
omarchy plugin validate .
"$(command -v qmllint || echo /usr/lib/qt6/bin/qmllint)" -I "$OMARCHY_SOURCE/shell" MonitorLayout.qml
echo "ok - monitor layout manifest and QML"
